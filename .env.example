# InterLink Relayer Configuration

# ── Source EVM chain ──────────────────────────────────────────────────────────
# EIP-155 chain ID (1=Ethereum, 42161=Arbitrum, 10=Optimism, 8453=Base).
# Checked against the RPC at startup; it is part of every payload hash.
CHAIN_ID=

# HTTP JSON-RPC endpoint (event polling, finality, and withdrawal delivery).
# Must support the "finalized" block tag.
EVM_HTTP_RPC_URL=

# Deployed InterlinkGateway contract address (0x...)
GATEWAY_ADDRESS=

# Optional: block to start scanning from (default: current head).
START_BLOCK=
POLL_INTERVAL_SECS=4
MAX_BLOCK_RANGE=2000

# ── Solana hub ────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
HUB_PROGRAM_ID=
# Relayer's Solana keypair (must hold an ILINK stake on the hub).
KEYPAIR_PATH=~/.config/solana/id.json

# ── Prover ────────────────────────────────────────────────────────────────────
# Groth16 proving key; the on-chain VK must come from this file (cargo run --bin export-vk).
PROVING_KEY_PATH=keys/interlink_pk.bin
# Allow generating a local (single-party, dev-only) key if the file is missing.
ALLOW_DEV_SETUP=false

# ── Hub → EVM withdrawals (optional) ──────────────────────────────────────────
# Key that sends releaseTokens transactions. Prefer a file over the raw variable.
EVM_PRIVATE_KEY_FILE=
# EVM_PRIVATE_KEY=
# Process hub signatures after this one on startup (default: only new ones).
HUB_START_SIGNATURE=
HUB_POLL_INTERVAL_SECS=5

# ── HTTP API ──────────────────────────────────────────────────────────────────
# Binds to localhost by default; the Docker image sets 0.0.0.0:8080.
API_ADDR=127.0.0.1:8080
# Required to enable the webhook endpoints (sent as "Authorization: Bearer <token>").
API_TOKEN=
